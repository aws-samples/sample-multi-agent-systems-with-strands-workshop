<mxfile host="Electron" agent="Claude Code">
  <diagram name="Architecture" id="arch">
    <mxGraphModel dx="1600" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Decision-Memo System — Brief in, Leadership Memo out" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="150" y="12" width="1200" height="28" as="geometry" />
        </mxCell>

        <!-- DECISION BRIEF -->
        <mxCell id="brief" value="&lt;b&gt;DECISION&lt;br&gt;BRIEF&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=13;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="20" y="175" width="105" height="55" as="geometry" />
        </mxCell>

        <!-- ORCHESTRATOR -->
        <mxCell id="orch" value="&lt;b&gt;Orchestrator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;P5 Agent-as-Tool&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474F;strokeColor=#263238;fontColor=#ffffff;fontSize=12;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="163" y="160" width="130" height="58" as="geometry" />
        </mxCell>

        <!-- PARALLEL HEADS GROUP -->
        <mxCell id="ph_box" value="parallel_heads  (P2 Fork-Join)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0288D1;strokeWidth=2;dashed=1;fontSize=10;fontStyle=1;fontColor=#0288D1;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="332" y="60" width="360" height="275" as="geometry" />
        </mxCell>

        <!-- 4 agents inside ph_box (2×2 grid) -->
        <mxCell id="planner" value="&lt;b&gt;Planner&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00695C;strokeColor=#004D40;fontColor=#ffffff;fontSize=12;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="355" y="95" width="120" height="44" as="geometry" />
        </mxCell>
        <mxCell id="researcher" value="&lt;b&gt;Researcher&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00897B;strokeColor=#00695C;fontColor=#ffffff;fontSize=12;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="545" y="95" width="120" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ana1" value="&lt;b&gt;Analyzer 1&lt;/b&gt;&lt;br&gt;Financial A/B/C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=11;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="355" y="185" width="120" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ana2" value="&lt;b&gt;Analyzer 2&lt;/b&gt;&lt;br&gt;Risk A/B/C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=11;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="545" y="185" width="120" height="44" as="geometry" />
        </mxCell>
        <mxCell id="hint" value="⟷  all 4 run simultaneously" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=9;fontStyle=2;fontColor=#0288D1;" vertex="1" parent="1">
          <mxGeometry x="340" y="258" width="345" height="20" as="geometry" />
        </mxCell>

        <!-- PROGRAM REVISOR GROUP -->
        <mxCell id="pr_box" value="program_revisor  (P3 Critic-Refiner)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B71C1C;strokeWidth=2;dashed=1;fontSize=10;fontStyle=1;fontColor=#B71C1C;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="745" y="105" width="365" height="190" as="geometry" />
        </mxCell>
        <mxCell id="revisor" value="&lt;b&gt;Program Revisor&lt;/b&gt;&lt;br&gt;weighs A / B / C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B71C1C;strokeColor=#7F0000;fontColor=#ffffff;fontSize=11;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="772" y="163" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="critic" value="&lt;b&gt;Critic&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#B71C1C;fontColor=#ffffff;fontSize=13;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="955" y="163" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_rc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;flowAnimation=1;strokeColor=#EF9A9A;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="revisor" target="critic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="loop" value="REVISION NEEDED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;flowAnimation=1;strokeWidth=2;strokeColor=#EF5350;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;fontSize=9;fontColor=#EF5350;fontStyle=1;" edge="1" parent="1" source="critic" target="revisor">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1005" y="258"/><mxPoint x="837" y="258"/></Array></mxGeometry>
        </mxCell>

        <!-- LEADERSHIP MEMO -->
        <mxCell id="memo" value="&lt;b&gt;LEADERSHIP&lt;br&gt;MEMO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=13;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="1170" y="165" width="105" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_app" value="APPROVED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;flowAnimation=1;strokeWidth=2;strokeColor=#43A047;endArrow=block;endFill=1;fontSize=9;fontColor=#43A047;fontStyle=1;" edge="1" parent="1" source="critic" target="memo">
          <mxGeometry relative="1" as="geometry" />
