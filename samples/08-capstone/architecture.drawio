        <!-- EDGES -->
        <!-- Brief → Orch -->
        <mxCell id="e_bo" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;flowAnimation=1;strokeColor=#78909C;strokeWidth=2;" edge="1" parent="1" source="brief" target="orch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Orch → 4 agents (fan-out, all blue) -->
<!-- parallel_heads box RIGHT SIDE → program_revisor (single clean arrow) -->
        <mxCell id="e_ph_pr" value="findings" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;flowAnimation=1;strokeColor=#B71C1C;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#B71C1C;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ph_box" target="revisor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="leg" value="Patterns:   P2 Parallel heads   ·   P3 Critic-Refiner   ·   P5 Agent-as-Tool   ·   P1 Sequential synthesis" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#546E7A;" vertex="1" parent="1">
          <mxGeometry x="250" y="380" width="1000" height="24" as="geometry" />
        </mxCell>

        <mxCell id="e_oph" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;flowAnimation=1;strokeColor=#0288D1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="ph_box">
          <mxGeometry relative="1" as="geometry" />
